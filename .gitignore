# ESP-IDF build trees, tool downloads and workstation configuration
build/
build_*/
/managed_components/
/sdkconfig
/sdkconfig.old
/sdkconfig.*.old
/.vscode/
/.idea/
*.map
*.elf
*.bin

# Local benchmark windows, host receipts, reports and observer state
/validation_artifacts/
/docs/audit/artifacts/
/test-results/
# Recognisable receiver outputs even when a custom output path is used
*.events.jsonl
*.events.jsonl.gz
*.notifications.jsonl
*.notifications.jsonl.gz
*.rx.bin.gz
*.observers.stop
/.pytest_cache/
__pycache__/
*.py[cod]
*.log

# Versioned golden and replay inputs include log and binary-format fixtures
!/tests/fixtures/**/*.log
!/tests/fixtures/**/*.bin
!/tests/fixtures/**/*.gz
!/tests/fixtures/**/*.jsonl

.DS_Store
Thumbs.db
