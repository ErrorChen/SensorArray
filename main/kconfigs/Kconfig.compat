menu "Compat"

# Hidden legacy symbols are kept only so older sdkconfig files can migrate.
# Business code must use SENSORARRAY_CFG_* or the new category symbols.

config SENSORARRAY_ENABLE_WIRED
    bool
    default SENSORARRAY_OUTPUT_USB_TEXT

config SENSORARRAY_ENABLE_BLE
    bool
    default SENSORARRAY_OUTPUT_BLE_CAP_TEXT

config SENSORARRAY_BLE_ENABLE
    bool
    default SENSORARRAY_OUTPUT_BLE_CAP_TEXT

config SENSORARRAY_FDC_CAP_PRINT_DECIMALS
    int
    default SENSORARRAY_CAP_DECIMALS

config SENSORARRAY_FDC_CAP_DECIMALS
    int
    default SENSORARRAY_CAP_DECIMALS

config SENSORARRAY_FDC_MATRIX_TARGET_FPS
    int
    default SENSORARRAY_TARGET_FPS

config SENSORARRAY_FDC_MATRIX_PERIOD_MS
    int
    default 50

config SENSORARRAY_FRAME_PERIOD_MS
    int
    default 50

config SENSORARRAY_FDC_TEXT_OUTPUT_FREQ_HZ
    bool
    default SENSORARRAY_FDC_TEXT_FREQ_HZ

config SENSORARRAY_FDC_TEXT_OUTPUT_CAP_TOTAL_PF
    bool
    default SENSORARRAY_FDC_TEXT_CAP_TOTAL_PF

config SENSORARRAY_FDC_TEXT_OUTPUT_BOTH_SEPARATE
    bool
    default SENSORARRAY_FDC_TEXT_BOTH_SEPARATE

config SENSORARRAY_FDC_TEXT_OUTPUT_BOTH_INLINE_DEBUG
    bool
    default SENSORARRAY_FDC_TEXT_BOTH_INLINE_DEBUG

config SENSORARRAY_FDC_RUNTIME_PROFILE_BALANCED
    bool
    default SENSORARRAY_FDC_RUNTIME_PROFILE_BALANCED_20FPS

config SENSORARRAY_FDC_RUNTIME_PROFILE_FAST
    bool
    default SENSORARRAY_FDC_RUNTIME_PROFILE_FAST_RUNTIME

endmenu
