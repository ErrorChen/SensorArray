menu "SensorArray Project"

config SENSORARRAY_ENABLE_WIRED
    bool "Enable wired transport (UART/USB-CDC)"
    default y

config SENSORARRAY_ENABLE_BLE
    bool "Enable BLE transport"
    default y

choice SENSORARRAY_ADS126X_VARIANT
    prompt "ADS126x variant"
    default SENSORARRAY_ADS1262
config SENSORARRAY_ADS1262
    bool "ADS1262 (ADC1 only)"
config SENSORARRAY_ADS1263
    bool "ADS1263 (ADC1 + ADC2)"
endchoice

menu "FDC2214 matrix"

config SENSORARRAY_FDC_PRIMARY_I2C_ADDR
    hex "Primary FDC I2C address (D1..D4)"
    default 0x2B

config SENSORARRAY_FDC_SECONDARY_I2C_ADDR
    hex "Secondary FDC I2C address (D5..D8)"
    default 0x2A

config SENSORARRAY_FDC_STARTUP_PROBE
    bool "Probe FDC addresses on startup"
    default y

config SENSORARRAY_FDC_TANK_INDUCTOR_UH
    int "Tank inductor value for optional conversion (uH, 0=unknown)"
    default 0
    range 0 1000000

config SENSORARRAY_FDC_TANK_INDUCTOR_NH
    int "Tank inductor value for MATRIXFDC capTotalPf (nH)"
    default 18000
    range 1 100000000
    help
        Default 18000 nH is 18.000 uH. capTotalPf is derived from freqHz
        in CPU code and does not add FDC I2C transactions.

config SENSORARRAY_FDC_EMIT_CAP_TOTAL_PF
    bool "Legacy: emit capTotalPf[64] in text output"
    default y
    help
        Kept for compatibility with old sdkconfig files. New builds should use
        SENSORARRAY_FDC_TEXT_OUTPUT_UNIT below.

choice SENSORARRAY_FDC_TEXT_OUTPUT_UNIT
    prompt "FDC matrix text output unit"
    default SENSORARRAY_FDC_TEXT_OUTPUT_CAP_TOTAL_PF
config SENSORARRAY_FDC_TEXT_OUTPUT_FREQ_HZ
    bool "Frequency Hz only"
config SENSORARRAY_FDC_TEXT_OUTPUT_CAP_TOTAL_PF
    bool "Total LC capacitance pF only"
config SENSORARRAY_FDC_TEXT_OUTPUT_BOTH_SEPARATE
    bool "Both, separate lines"
config SENSORARRAY_FDC_TEXT_OUTPUT_BOTH_INLINE_DEBUG
    bool "Both inline, debug only"
endchoice

config SENSORARRAY_FDC_REF_CLOCK_USE_EXTERNAL
    bool "Use external 40MHz CLKIN for FDC2214"
    default y

config SENSORARRAY_FDC_REF_CLOCK_USE_EXTERNAL_VALUE
    int
    default 1 if SENSORARRAY_FDC_REF_CLOCK_USE_EXTERNAL
    default 0

config SENSORARRAY_FDC_EXTERNAL_CLOCK_HZ
    int "FDC external CLKIN frequency Hz"
    default 40000000
    range 2000000 40000000

config SENSORARRAY_FDC_MATRIX_PERIOD_MS
    int "Default FDC matrix frame period (ms)"
    default 50
    range 10 10000
    help
        First-stage target is 20 fps, i.e. 50 ms per 64-point MATRIXFDC frame.

config SENSORARRAY_FDC_MATRIX_TARGET_FPS
    int "FDC matrix first-stage target fps"
    default 20
    range 1 1000

config SENSORARRAY_FDC_MATRIX_SETTLE_US
    int "Settle time after row/path switching (us)"
    default 1000
    range 0 100000

config SENSORARRAY_FDC_MATRIX_DISCARD_SAMPLES
    int "Discarded sample groups after each row switch"
    default 0
    range 0 8

config SENSORARRAY_FDC_DISCARD_FRAMES_AFTER_ROW_SWITCH
    int "Autoscan frames discarded per FDC after each row switch"
    default 0
    range 0 8

config SENSORARRAY_FDC_ROW_EPOCH_RESTART_ENABLE
    bool "Restart each FDC row conversion epoch"
    default y

config SENSORARRAY_FDC_ROW_EPOCH_RESTART_METHOD_SLEEP
    bool "Use CONFIG.SLEEP_MODE_EN for row epoch restart"
    default y
    depends on SENSORARRAY_FDC_ROW_EPOCH_RESTART_ENABLE

config SENSORARRAY_FDC_ROW_SWITCH_SETTLE_US
    int "Row switch settle time while FDC devices are sleeping (us)"
    default 50
    range 0 100000

config SENSORARRAY_FDC_PARALLEL_DUAL_BUS_READ
    bool "Read primary and secondary FDC devices with dual worker tasks"
    default y

config SENSORARRAY_FDC_PARALLEL_DUAL_BUS_READ_SAFE
    bool "Require guarded FDC dual-worker result handoff"
    default y

config SENSORARRAY_FDC_FORCE_SINGLE_THREAD_READ
    bool "Force serial FDC formal row reads"
    default n

config SENSORARRAY_FDC_PARALLEL_DISABLE_AFTER_TIMEOUT_IN_FRAME
    bool "Disable FDC parallel reads for the rest of a frame after a worker timeout"
    default y

config SENSORARRAY_FDC_PARALLEL_RETRY_INTERVAL_FRAMES
    int "FDC parallel retry interval after an in-frame timeout"
    default 10
    range 0 10000

config SENSORARRAY_FDC_WORKER_TASK_STACK
    int "FDC worker task stack bytes"
    default 6144
    range 4096 32768

config SENSORARRAY_FDC_WORKER_TASK_PRIO
    int "FDC worker task priority"
    default SENSORARRAY_SCAN_TASK_PRIO
    range 1 24

config SENSORARRAY_FDC_WORKER_TASK_CORE
    int "FDC worker task core (-1 means no affinity)"
    default -1
    range -1 1
    help
        -1 keeps the workers unpinned and must use the unpinned static task API.
        Pinned task creation only receives normalized core IDs in the valid CPU
        range.

config SENSORARRAY_FDC_WORKER_SYNC_TIMEOUT_MS
    int "FDC worker row synchronization timeout (ms)"
    default 25
    range 1 1000

config SENSORARRAY_FDC_INTB_ENABLE
    bool "Use FDC2214 INTB data-ready hint"
    default y

config SENSORARRAY_FDC_INTB_ACTIVE_LOW
    bool "Treat FDC2214 INTB as active-low"
    default y
    depends on SENSORARRAY_FDC_INTB_ENABLE

config SENSORARRAY_FDC_INTB1_GPIO
    int "Primary FDC INTB GPIO"
    default 17
    range -1 48

config SENSORARRAY_FDC_INTB2_GPIO
    int "Secondary FDC INTB GPIO"
    default 18
    range -1 48

config SENSORARRAY_FDC_INTB_TRIGGER_ANYEDGE
    bool "Use any-edge trigger for FDC INTB"
    default n
    depends on SENSORARRAY_FDC_INTB_ENABLE

config SENSORARRAY_FDC_INTB_TRIGGER_FALLING_EDGE
    bool "Use falling-edge trigger for active-low FDC INTB"
    default y
    depends on SENSORARRAY_FDC_INTB_ENABLE

config SENSORARRAY_FDC_INTB_WAIT_TIMEOUT_US
    int "INTB/DRDY wait timeout per row-device (us)"
    default 10000
    range 100 1000000

choice SENSORARRAY_FDC_READY_POLICY
    prompt "FDC matrix ready policy"
    default SENSORARRAY_FDC_READY_POLICY_INTB_STRICT_LEVEL
config SENSORARRAY_FDC_READY_POLICY_POLL_ONLY
    bool "Debug: bounded STATUS polling only"
config SENSORARRAY_FDC_READY_POLICY_INTB_THEN_STATUS
    bool "INTB hint, then one STATUS verify"
config SENSORARRAY_FDC_READY_POLICY_INTB_WITH_POLL_FALLBACK
    bool "Legacy diagnostic: INTB hint, STATUS verify, bounded fallback polling"
config SENSORARRAY_FDC_READY_POLICY_INTB_STRICT_LEVEL
    bool "Production: INTB strict level, one STATUS ack after INTB"
endchoice

config SENSORARRAY_FDC_AFTER_INTB_RECHECK_ENABLE
    bool "Allow short after-INTB STATUS recheck when unread is full but DRDY is not closed"
    default y

config SENSORARRAY_FDC_AFTER_INTB_RECHECK_MAX
    int "Maximum after-INTB STATUS rechecks"
    default 3
    range 0 16
    depends on SENSORARRAY_FDC_AFTER_INTB_RECHECK_ENABLE

config SENSORARRAY_FDC_AFTER_INTB_RECHECK_INTERVAL_US
    int "Delay between after-INTB rechecks (us)"
    default 250
    range 0 10000
    depends on SENSORARRAY_FDC_AFTER_INTB_RECHECK_ENABLE

config SENSORARRAY_FDC_AFTER_INTB_RECHECK_DEADLINE_US
    int "Total after-INTB recheck deadline (us)"
    default 1000
    range 0 100000
    depends on SENSORARRAY_FDC_AFTER_INTB_RECHECK_ENABLE

config SENSORARRAY_FDC_INTB_WAIT_MARGIN_US
    int "Extra INTB wait margin after estimated conversion time (us)"
    default 2000
    range 0 100000

config SENSORARRAY_FDC_READY_GUARD_US
    int "Guard time after estimated FDC conversion before STATUS polling (us)"
    default 3000
    range 0 100000

config SENSORARRAY_FDC_POLL_FALLBACK_MAX_POLLS
    int "Maximum STATUS fallback polls per row-device"
    default 3
    range 0 100

config SENSORARRAY_FDC_POLL_FALLBACK_DELAY_US
    int "Delay between fallback STATUS polls (us)"
    default 1000
    range 0 10000

config SENSORARRAY_FDC_READY_MAX_POLLS_AFTER_UNREAD_BEFORE_DRDY
    int "Maximum short STATUS polls after unread-full before DRDY"
    default 3
    range 1 100

config SENSORARRAY_FDC_READY_POLL_INTERVAL_US
    int "Delay between guarded STATUS ready polls (us)"
    default 1000
    range 0 10000

config SENSORARRAY_FDC_REQUIRE_DRDY_FOR_VALID
    bool "Require DRDY plus unread bits before DATA_CHx reads"
    default y

config SENSORARRAY_FDC_SUPPRESS_STATUS_READ_BEFORE_INTB
    bool "Suppress repeated STATUS reads before INTB is ready"
    default y

config SENSORARRAY_FDC_DISABLE_INTB_FOR_DEBUG
    bool "Disable FDC INTB output for debug polling"
    default n

config SENSORARRAY_FDC_INTB_FALLBACK_POLLING
    bool "Fall back to STATUS polling when INTB is unavailable or late"
    default n
    depends on SENSORARRAY_FDC_INTB_ENABLE

config SENSORARRAY_FDC_ROW_DEVICE_RETRY_MAX
    int "Maximum row-device watchdog retries"
    default 1
    range 0 4

config SENSORARRAY_FDC_ROW_DEVICE_WATCHDOG_MULTIPLIER
    int "Row-device watchdog multiplier of one row budget"
    default 10
    range 1 100

config SENSORARRAY_FDC_ROW_DEVICE_WATCHDOG_OVERRIDE_US
    int "Override row-device watchdog hard timeout (us, 0=derive from frame budget)"
    default 0
    range 0 1000000

config SENSORARRAY_FDC_RECOVERY_RESET_ON_PROGRESS
    bool "Allow recovery soft timeout to reset only on real device progress"
    default y

config SENSORARRAY_FDC_INTB_WEAK_PULLUP
    bool "Enable weak pull-up on FDC INTB GPIOs"
    default y
    depends on SENSORARRAY_FDC_INTB_ENABLE

config SENSORARRAY_FDC_INTB_DEBUG_LOG
    bool "Print verbose FDC INTB diagnostics"
    default n
    depends on SENSORARRAY_FDC_INTB_ENABLE

choice SENSORARRAY_FDC_LOG_FORMAT
    prompt "FDC diagnostic log format"
    default SENSORARRAY_FDC_LOG_FORMAT_COMPACT
config SENSORARRAY_FDC_LOG_FORMAT_VERBOSE
    bool "Verbose key=value diagnostics"
config SENSORARRAY_FDC_LOG_FORMAT_COMPACT
    bool "Compact token diagnostics"
endchoice

choice SENSORARRAY_LOG_FORMAT
    prompt "SensorArray runtime log format"
    default SENSORARRAY_LOG_FORMAT_COMPACT_KV
config SENSORARRAY_LOG_FORMAT_LEGACY
    bool "Legacy verbose logs"
config SENSORARRAY_LOG_FORMAT_COMPACT_KV
    bool "Compact key=value logs"
config SENSORARRAY_LOG_FORMAT_COMPACT_CSV
    bool "Compact CSV logs"
endchoice

config SENSORARRAY_LOG_KEEP_LEGACY_CAP_TAG
    bool "Keep MATRIXFDC_CAP tag for GUI compatibility"
    default y

config SENSORARRAY_LOG_OMIT_DEFAULT_FIELDS
    bool "Omit default masks and sentinel fields from compact normal logs"
    default y

config SENSORARRAY_LOG_MASK_SHORT_FORM
    bool "Use compact mask shorthand in logs"
    default y

config SENSORARRAY_FDC_CAP_PRINT_DECIMALS
    int "Decimal places for MATRIXFDC capacitance output"
    default 6
    range 0 6

config SENSORARRAY_FDC_ROW_LOG_LEVEL
    int "FDC row log level (0 off, 1 anomaly, 2 sampled, 3 verbose compact, 4 legacy verbose)"
    default 1
    range 0 4

config SENSORARRAY_FDC_DEVICE_READ4_LOG_LEVEL
    int "FDC read4 log level (0 off, 1 anomaly, 2 sampled, 3 sampled raw/freq, 4 every read)"
    default 1
    range 0 4

config SENSORARRAY_FDC_LOG_READY_EVERY_ROW
    bool "Print FDC ready diagnostics for every row"
    default n

config SENSORARRAY_FDC_LOG_ROW_PARALLEL_TIMING
    bool "Print per-row FDC parallel overlap timing"
    default n

config SENSORARRAY_FDC_LOG_FULL_CAP_FRAME
    bool "Print full MATRIXFDC_CAP frame output"
    default y

config SENSORARRAY_FDC_LOG_COMPACT_CAP_FRAME
    bool "Print compact MATRIXFDC frame output"
    default y

config SENSORARRAY_FDC_DIFF_CACHE_APPLY
    bool "Apply only changed FDC row cache registers"
    default y

config SENSORARRAY_FDC_CACHE_APPLY_VERBOSE_LOG
    bool "Print verbose cache no-diff/skipped logs"
    default n

config SENSORARRAY_FDC_SETTLECOUNT_DEFAULT
    hex "Default FDC SETTLECOUNT_CHx"
    default 0x0080
    help
        Conservative matrix default. The previous 0x000A was too aggressive for
        row switching; speed tuning should happen after valid conversions are stable.

config SENSORARRAY_FDC_ROW_WAIT_SAFETY_US
    int "Safety margin after one FDC autoscan cycle (us)"
    default 2000
    range 0 100000

config SENSORARRAY_FDC_SWEEP_STEP_TIMEOUT_MS
    int "FDC sweep timeout per candidate (ms)"
    default 180
    range 1 5000

config SENSORARRAY_FDC_SWEEP_TOTAL_TIMEOUT_MS
    int "FDC sweep bounded timeout per channel (ms)"
    default 2500
    range 10 60000

config SENSORARRAY_FDC_SWEEP_SETTLE_MS
    int "FDC sweep settle time after applying a candidate (ms)"
    default 20
    range 0 1000

config SENSORARRAY_FDC_SWEEP_SAMPLE_TIMEOUT_MS
    int "FDC sweep sample wait timeout (ms)"
    default 80
    range 1 5000

config SENSORARRAY_FDC_SWEEP_SAMPLE_POLL_MS
    int "FDC sweep sample polling interval (ms)"
    default 2
    range 1 1000

config SENSORARRAY_FDC_DIRECT_FAIL_THRESHOLD
    int "Direct-read failures before fast sweep"
    default 3
    range 1 32

config SENSORARRAY_FDC_CELL_FAST_SWEEP_FAIL_THRESHOLD
    int "Cell failures before a bounded fast sweep"
    default 2
    range 1 32

config SENSORARRAY_FDC_FAST_FAIL_THRESHOLD
    int "Fast-sweep failures before full rescue"
    default 2
    range 1 32

config SENSORARRAY_FDC_FAST_SWEEP_COOLDOWN_MS
    int "Cooldown between fast sweeps for a cell"
    default 30000
    range 0 600000

config SENSORARRAY_FDC_FAST_SWEEP_MIN_COOLDOWN_MS
    int "Minimum cooldown between automatic runtime fast sweeps for a cell"
    default 30000
    range 0 600000

config SENSORARRAY_FDC_RUNTIME_FAST_SWEEP_ENABLE
    bool "Allow automatic runtime fast sweeps"
    default y

config SENSORARRAY_FDC_REAPPLY_CACHE_ON_WARNING
    bool "Reapply cached row config on amplitude warnings"
    default n

config SENSORARRAY_FDC_WARNING_REAPPLY_THRESHOLD
    int "Amplitude warnings before forcing cached row reapply"
    default 2
    range 1 32

config SENSORARRAY_FDC_RESCUE_HARD_ERROR_THRESHOLD
    int "Hard runtime errors before rescue can be scheduled"
    default 4
    range 1 32

config SENSORARRAY_FDC_WARNING_REAPPLY_ONCE_PER_FINGERPRINT
    bool "Allow at most one amplitude-warning cache reapply per fingerprint"
    default y

config SENSORARRAY_FDC_AMPLITUDE_FAST_SWEEP_THRESHOLD
    int "Fresh amplitude warnings before local fast sweep"
    default 4
    range 1 32

config SENSORARRAY_FDC_WARNING_REAPPLY_COOLDOWN_FRAMES
    int "Cooldown between amplitude-warning sanity reapply attempts"
    default 50
    range 0 100000

config SENSORARRAY_FDC_WARNING_FAST_SWEEP_COOLDOWN_MS
    int "Cooldown between amplitude-warning fast sweep requests"
    default 1000
    range 0 600000

config SENSORARRAY_FDC_FULL_SWEEP_RESCUE_COOLDOWN_MS
    int "Cooldown between full rescue sweeps for a cell"
    default 10000
    range 0 600000

config SENSORARRAY_FDC_FULL_RESCUE_COOLDOWN_MS
    int "Cooldown between full-matrix rescue sweeps"
    default 3000
    range 0 600000

config SENSORARRAY_FDC_SUPPRESS_ALL_ZERO_FRAMES
    bool "Suppress all-zero invalid MATRIXFDC frames"
    default n

config SENSORARRAY_FDC_BOOT_SWEEP_REQUIRED
    bool "Require at least one valid boot sweep sample before normal matrix output"
    default y

config SENSORARRAY_FDC_BOOT_MIN_VALID_CELLS
    int "Minimum valid FDC cells for normal boot quality"
    default 48
    range 1 64

config SENSORARRAY_FDC_BOOT_ALLOW_DEGRADED
    bool "Allow explicit degraded FDC boot quality"
    default y
    help
        When enabled, a boot sweep with some valid cells but fewer than the
        required minimum is reported as degraded instead of transport failure.

config SENSORARRAY_FDC_BOOT_REQUIRED_ROWS_MASK
    hex "Required FDC boot row mask"
    default 0xFF
    range 0 0xFF

config SENSORARRAY_REQUIRE_DUAL_FDC_FOR_BOOT
    bool "Require both primary and secondary FDC devices for normal boot"
    default y
    help
        When enabled, a missing secondary FDC enters diagnostic/safe idle
        instead of silently treating D5-D8 as generic invalid cells.

config SENSORARRAY_FDC_NO_OSC_RESCUE_COOLDOWN_MS
    int "Cooldown for no-oscillation rescue"
    default 500
    range 0 60000

config SENSORARRAY_FDC_ALL_INVALID_RESTART_THRESHOLD
    int "Failed all-invalid rescues before diagnostic mode/restart"
    default 3
    range 1 32

config SENSORARRAY_FDC_ALL_INVALID_RESCUE_THRESHOLD
    int "Consecutive all-invalid frames before full rescue"
    default 3
    range 1 32

config SENSORARRAY_FDC_ALL_INVALID_FULL_SWEEP_THRESHOLD
    int "Consecutive all-invalid frames before queuing a full sweep"
    default 3
    range 1 32

config SENSORARRAY_FDC_FULL_SWEEP_REQUEST_COOLDOWN_MS
    int "Cooldown between full sweep requests"
    default 5000
    range 0 600000

config SENSORARRAY_FDC_MAX_CONSECUTIVE_FULL_SWEEP_FAILS
    int "Full matrix rescue failures before diagnostic mode"
    default 3
    range 1 32

config SENSORARRAY_FDC_ROW_RESCUE_FAIL_COUNT
    int "Per-row fail count hint for rescue diagnostics"
    default 4
    range 1 8

config SENSORARRAY_FDC_RESCUE_TASK_STACK
    int "Reserved FDC rescue task stack bytes"
    default 12288
    range 4096 32768

config SENSORARRAY_FDC_VERBOSE_REG_DUMP
    bool "Dump FDC registers on boot/rescue failure"
    default y

config SENSORARRAY_FDC_DIAG_DUMP_REGS
    bool "Dump FDC registers while in diagnostic mode"
    default n

config SENSORARRAY_FDC_DIAG_DUMP_INTERVAL_MS
    int "Diagnostic FDC register dump interval (ms)"
    default 5000
    range 100 600000
    depends on SENSORARRAY_FDC_DIAG_DUMP_REGS

config SENSORARRAY_FDC_DIAG_DUMP_SKIP_OFFLINE_BUS
    bool "Skip diagnostic FDC register dump when an I2C bus is offline"
    default y
    depends on SENSORARRAY_FDC_DIAG_DUMP_REGS

config SENSORARRAY_FDC_VERBOSE_SCAN_LOG
    bool "Print verbose per-row FDC scan diagnostics"
    default n

config SENSORARRAY_FDC_SAMPLE_DEVICE_LOG_EVERY_N_FRAMES
    int "Sample normal FDC row/device diagnostics every N frames"
    default 5
    range 0 10000
    help
        0 disables sampled normal-path diagnostics. Exceptional timeout,
        stale, duplicate, I2C error and fallback diagnostics are still printed.

config SENSORARRAY_FDC_LOG_NORMAL_POLL_SUCCESS
    bool "Print normal full-poll success diagnostics"
    default n

config SENSORARRAY_LOG_FRAME_SUMMARY
    bool "Print formal FDC frame summary"
    default y

config SENSORARRAY_LOG_FRAME_SUMMARY_EVERY_N_FRAMES
    int "Compact frame summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_LOG_FRAME_SUMMARY_ON_ANOMALY
    bool "Print frame summary immediately on anomaly"
    default y

config SENSORARRAY_LOG_FRAME_OUTPUT_LEGACY
    bool "Print legacy FDC_FRAME_OUTPUT every frame"
    default n

config SENSORARRAY_LOG_ROW_SUMMARY
    bool "Print formal FDC row summary"
    default n

config SENSORARRAY_LOG_I2C_STATS_EVERY_N_FRAMES
    int "BOARD_I2C_STATS aggregate period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_LOG_TIMING_STATS_EVERY_N_FRAMES
    int "FDC_TIMING_STATS aggregate period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_LOG_LOW_LEVEL_I2C_XFER
    bool "Print every board-level I2C transaction"
    default n

config SENSORARRAY_LOG_FDC_REGISTER_TRACE
    bool "Print FDC register trace"
    default n

config SENSORARRAY_LOG_SWEEP_CANDIDATE_VERBOSE
    bool "Print every sweep candidate detail"
    default n

config SENSORARRAY_LOG_WORKER_VERBOSE
    bool "Print verbose FDC worker logs"
    default n

config SENSORARRAY_LOG_CACHE_APPLY_VERBOSE
    bool "Print verbose FDC cache apply details"
    default n

config SENSORARRAY_FDC_ALLOW_SAFE_DEFAULT_FORMAL_READ
    bool "Allow safe-default FDC row configs in formal reads"
    default n
    help
        Keep disabled for normal operation: uncalibrated cells are marked
        invalid and scheduled for rescue instead of being read as normal data.

config SENSORARRAY_FDC_RAW_DEBUG_LOG
    bool "Print DEBUGFDC_RAW alongside MATRIXFDC"
    default n

config SENSORARRAY_FDC_TIMING_SUMMARY_EVERY_N_FRAMES
    int "FDC timing summary output interval in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_TIMING_SUMMARY_PERIOD_FRAMES
    int "FDC compact timing aggregate period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_PROFILE_LOG_EVERY_N_FRAMES
    int "FDC profile compact summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_READY_LOG_EVERY_N_FRAMES
    int "FDC ready compact summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_TIMING_COMPACT_EVERY_N_FRAMES
    int "FDC compact timing summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_QUALITY_LOG_EVERY_N_FRAMES
    int "FDC quality/sweep compact summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_I2C_LOG_EVERY_N_FRAMES
    int "FDC I2C compact summary period in MATRIXFDC frames"
    default 5
    range 0 10000

config SENSORARRAY_FDC_TIMING_SUMMARY_AGGREGATE
    bool "Aggregate FDC timing summary over multiple frames"
    default y

config SENSORARRAY_FDC_TIMING_OVERRUN_IMMEDIATE_LOG
    bool "Print compact bottleneck on frame overrun"
    default y

config SENSORARRAY_FDC_TIMING_VERBOSE_PER_FRAME
    bool "Print per-frame timing summary"
    default n

config SENSORARRAY_FDC_PROFILE_ROW_DEFAULT
    bool "Print SCAN_ROW_TIMING by default"
    default n

config SENSORARRAY_FDC_PROFILE_DEVICE_DEFAULT
    bool "Print SCAN_DEVICE_TIMING by default"
    default n

config SENSORARRAY_FDC_I2C_TRACE_RING_SIZE
    int "FDC I2C trace ring records"
    default 128
    range 0 2048

choice SENSORARRAY_FDC_VERIFY_MODE
    prompt "Runtime FDC register readback verify mode"
    default SENSORARRAY_FDC_VERIFY_MODE_STARTUP_ONLY
config SENSORARRAY_FDC_VERIFY_MODE_FULL
    bool "Full runtime verify"
config SENSORARRAY_FDC_VERIFY_MODE_STARTUP_ONLY
    bool "Startup/cache build verify only"
config SENSORARRAY_FDC_VERIFY_MODE_NONE
    bool "No runtime readback verify"
endchoice

config SENSORARRAY_FDC_HIGH_SPEED_PROFILE
    bool "Enable experimental high-speed FDC profile candidates"
    default n
    help
        Experimental option for lower RCOUNT/SETTLECOUNT candidates. The
        normal boot/cache mechanism remains active; this is not the default
        stable profile.

config SENSORARRAY_FDC_FORMAL_FAST_PROFILE_ENABLE
    bool "Maintain formal fast profile metadata for runtime reads"
    default y

config SENSORARRAY_FDC_FORMAL_FAST_TARGET_ROUND_US
    int "Formal fast profile target autoscan round time (us)"
    default 4000
    range 100 100000

config SENSORARRAY_FDC_PROFILE_TOO_SLOW_WARN_US
    int "Warn when profile autoscan round estimate exceeds this row budget (us)"
    default 6250
    range 100 1000000

config SENSORARRAY_FDC_TIMING_LOG_EVERY_N_FRAMES
    int "Deprecated alias for verbose timing output interval"
    default SENSORARRAY_FDC_TIMING_SUMMARY_EVERY_N_FRAMES
    range 0 10000

config SENSORARRAY_FDC_DIRECT_QUALITY_SAMPLES
    int "Direct-read quality sample count"
    default 6
    range 4 8

endmenu

menu "Scheduling"

config SENSORARRAY_SCAN_TASK_CORE
    int "Scan task core id (0 or 1)"
    default 1
    range 0 1

config SENSORARRAY_COMM_TASK_CORE
    int "Comm task core id (0 or 1)"
    default 0
    range 0 1

config SENSORARRAY_BLE_TASK_CORE
    int "BLE task core id (0 or 1)"
    default 0
    range 0 1
    depends on SENSORARRAY_ENABLE_BLE

config SENSORARRAY_SCAN_TASK_STACK
    int "Scan task stack bytes"
    default 8192

config SENSORARRAY_SCAN_TASK_PRIO
    int "Scan task priority"
    default 12

config SENSORARRAY_COMM_TASK_STACK
    int "Comm task stack bytes"
    default 4096

config SENSORARRAY_COMM_TASK_PRIO
    int "Comm task priority"
    default 8

endmenu

menu "SPI DMA (ADS126x)"

config SENSORARRAY_SPI_USE_DMA
    bool "Enable SPI DMA where possible"
    default y

config SENSORARRAY_SPI_MAX_TRANSFER_BYTES
    int "SPI max transfer size (bytes)"
    default 64

endmenu

menu "Matrix defaults"

config SENSORARRAY_MATRIX_ROWS
    int "Matrix rows"
    default 8

config SENSORARRAY_MATRIX_COLS
    int "Matrix cols"
    default 8

config SENSORARRAY_FRAME_PERIOD_MS
    int "Target frame period (ms)"
    default SENSORARRAY_FDC_MATRIX_PERIOD_MS

config SENSORARRAY_OVERSAMPLE
    int "Oversample count per point"
    default 1

config SENSORARRAY_MEASURE_LOCK_TIMEOUT_MS
    int "Measurement lock timeout (ms)"
    default 5000
    range 1 60000

endmenu

menu "ADS read sequencing policy"

config SENSORARRAY_ADS_READ_STOP1_BEFORE_MUX
    bool "Call STOP1 before INPMUX change"
    default n

config SENSORARRAY_ADS_READ_SETTLE_AFTER_MUX_MS
    int "Delay after INPMUX change (ms)"
    default 0
    range 0 5000

config SENSORARRAY_ADS_READ_START1_EVERY_READ
    bool "Call START1 on every read"
    default y

config SENSORARRAY_ADS_READ_BASE_DISCARD_COUNT
    int "Base discard count before each final sample"
    default 0
    range 0 32

config SENSORARRAY_ADS_READ_RETRY_COUNT
    int "Retry count on timeout/error"
    default 0
    range 0 16

endmenu

menu "I2C recovery"

config SENSORARRAY_I2C_RECOVER_ON_TIMEOUT
    bool "Recover I2C bus after timeout when pins look stuck"
    default n

endmenu

endmenu
