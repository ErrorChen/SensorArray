+            "-DCONFIG_SENSORARRAY_ADS1262=1", "-DCONFIG_SENSORARRAY_ADS_DATA_RATE=15",
+            "-DCONFIG_SENSORARRAY_SPI_USE_DMA=1", "-DCONFIG_ADS126X_SPI_CLOCK_HZ=2000000",
