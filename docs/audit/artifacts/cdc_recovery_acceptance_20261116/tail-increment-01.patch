+    if (group >= SENSORARRAY_ADS_TIMING_GROUPS) { b[0] = '\0'; return 0u; }
+    const sensorarrayAdsTimingRecord_t *v = &r->records[group][index];
+    const ads126xAdcTailEvidence_t *t = &v->tail;
