diff --git a/tools/test_ads_timing_control.py b/tools/test_ads_timing_control.py
new file mode 100644
index 0000000..194001e
--- /dev/null
+++ b/tools/test_ads_timing_control.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Execute real timing control/mailbox/main-boundary code with synthetic hardware.
+
+The reentrant producer hook is inserted after the real shared reservation and
+before ControlPost publishes its local slot; the second transport must lose the
+existing global configuration arbiter. No ADC samples here are HIL evidence.
+"""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+from test_main_config_commit import function
+from test_rowmodes_ack_guard import writeFakeHeaders
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main() -> int:
+    source = (ROOT / "main/main.c").read_text()
+    boundary = function(source, "static void sensorarrayRunAdsTimingCommand(")
+    runtime = function(source, "static esp_err_t sensorarrayRuntimeQueryCommand(")
+    command = function(runtime, '    if (strncmp(command, "ADSCHK=TIMING", 13u) == 0)')
+    callbacks = "\n".join(function(source, name) for name in [
+        "static void sensorarrayControlReplyPublished(",
+        "static void sensorarrayControlReplyFailed("])
+    apply = function(source, "static void sensorarrayApplyPendingCommands(")
+    assert apply.index("sensorarrayAdsTimingControlExpire") < apply.index("while (sensorarrayCommandMailboxTryReceive")
+    assert apply.index("SENSORARRAY_COMMAND_ADS_TIMING") < apply.index("sensorarrayFrontendsHeld()")
+    assert "sensorarrayRunAdsTimingCommand(ctx, &command);\n            return;" in apply
+    assert source.count("sensorarrayAdsTimingControlHandles(command)") == 2
+    assert source.count("sensorarrayLinkDiagnosticsHandles(command)") == 2
+    assert source.count("ads_timing_probe_v1/ble_service_obs_v1/work_reason_v1") == 2
+    probe = (ROOT / "core/measure/ads/sensorarrayAdsTimingProbe.c").read_text()
+    formatters = probe[probe.index("static size_t sensorarrayAdsTimingFormatted("):]
+    adc = (ROOT / "components/ads126xAdc/include/ads126xAdc.h").read_text()
+    end = adc.index("} ads126xAdc1RegisterSnapshot_t;") + len("} ads126xAdc1RegisterSnapshot_t;")
+    snapshot = adc[adc.rfind("typedef struct {", 0, end):end]
+    test = (ROOT / "tests/host/test_ads_timing_control.c").read_text()
+    test = test.replace("/* EXISTING_MAILBOX_TEST */", '#include "' + str(ROOT / "tests/host/test_rowmodes_ack_guard.c") + '"')
+    test = test.replace("/* PRODUCTION_FORMATTERS */", formatters)
+    test = test.replace("/* PRODUCTION_BOUNDARY */", boundary)
+    test = test.replace("/* PRODUCTION_CALLBACKS */", callbacks)
+    test = test.replace("/* PRODUCTION_COMMAND */", command)
+    with tempfile.TemporaryDirectory(prefix="sensorarray-ads-timing-control-") as directory:
+        tmp = Path(directory); fake = tmp / "fake"; fake.mkdir()
+        writeFakeHeaders(fake)
+        freertos = fake / "freertos/FreeRTOS.h"
+        f = freertos.read_text(); start = f.index("typedef struct { int locked; }")
+        f = f[:start] + """#include <pthread.h>
+typedef pthread_mutex_t portMUX_TYPE;
+#define portMUX_INITIALIZER_UNLOCKED PTHREAD_MUTEX_INITIALIZER
+#define portENTER_CRITICAL(p) pthread_mutex_lock(p)
+#define portEXIT_CRITICAL(p) pthread_mutex_unlock(p)
+"""
+        freertos.write_text(f)
+        (fake / "ads126xAdc.h").write_text('#pragma once\n#include <stdint.h>\n#include "esp_err.h"\n' +
+            snapshot + '\ntypedef struct ads126xAdcHandle ads126xAdcHandle_t;\n')
+        unit = tmp / "unit.c"; unit.write_text(test)
+        executable = tmp / "test"
+        cmd = [os.environ.get("CC", "/usr/bin/gcc"), "-std=c11", "-D_XOPEN_SOURCE=700",
+               "-Wall", "-Wextra", "-Werror", "-pthread", "-O1", "-g"]
+        for path in [fake, ROOT / "tests/host/include", ROOT / "core/config",
+                     ROOT / "core/measure/include", ROOT / "core/measure/ads",
+                     ROOT / "core/transport", ROOT / "main/control"]:
+            cmd += ["-I", str(path)]
+        subprocess.run(cmd + [str(unit), "-o", str(executable)], check=True)
+        subprocess.run([str(executable)], check=True, timeout=20)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/test_ads_timing_probe.py b/tools/test_ads_timing_probe.py
new file mode 100644
index 0000000..3cf7c19
--- /dev/null
+++ b/tools/test_ads_timing_probe.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Execute production timing probe, Gap wrapper and ADS driver on a synthetic bus."""
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import tempfile
+
+from test_main_config_commit import function
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    cc = os.environ.get("CC") or shutil.which("gcc") or shutil.which("clang")
+    if not cc:
+        raise RuntimeError("native C compiler required")
+    source = (root / "core/measure/ads/sensorarrayAdsGap.c").read_text()
+    functions = [function(source, name) for name in (
+        "static void sensorarrayAdsTransactionBegin(",
+        "static void sensorarrayAdsTransactionEnd(",
+        "static bool sensorarrayAdsSnapshotFromRegisterCache(",
+        "static uint8_t sensorarrayAdsBatteryRegisterMask(",
+        "static bool sensorarrayAdsBatterySnapshotsMatch(",
+        "static void sensorarrayAdsPopulateRestoredRegisterCache(",
+        "esp_err_t sensorarrayAdsGapRunTimingProbe(",
+    )]
+    # The populate helper has a forward declaration; extract its actual body.
+    marker = "static void sensorarrayAdsPopulateRestoredRegisterCache("
+    functions[-2] = function(source[source.rindex(marker):], marker)
+    end = source.index("} sensorarrayAdsBatteryCompare_t;") + len("} sensorarrayAdsBatteryCompare_t;")
+    comparison = source[source.rindex("typedef struct {", 0, end):end]
+    driver_bus = (root / "tests/host/test_ads_driver_reliability.c").read_text()
+    driver_bus = driver_bus.replace('"../../components/ads126xAdc/ads126xAdc.c"',
+        '"' + str(root / "components/ads126xAdc/ads126xAdc.c") + '"')
+    driver_bus = driver_bus.replace("uint32_t ulTaskNotifyTake(", "uint32_t driverDefaultNotify(")
+    driver_bus = driver_bus.replace("int gpio_get_level(", "int driverDefaultGpioLevel(")
+    driver_bus = driver_bus.replace("int64_t esp_timer_get_time(", "int64_t driverDefaultTimer(")
+    # Model this target's actual100Hz tick in the reused synthetic RTOS bus.
+    driver_bus = driver_bus.replace("ticks * 1000u", "ticks * (1000000u / configTICK_RATE_HZ)")
+    driver_bus = driver_bus.replace("ticks * 1000", "ticks * (1000000u / configTICK_RATE_HZ)")
+    driver_bus = driver_bus.replace("if (desired_hz == 1900000)",
+        "if (desired_hz == 550000) { return 551724; }\n    if (desired_hz == 1900000)")
+    harness = (root / "tests/host/test_ads_timing_probe.c").read_text()
+    harness = harness.replace("/* PRODUCTION_GAP_TYPES */", comparison)
+    harness = harness.replace("/* PRODUCTION_GAP_FUNCTIONS */", "\n".join(functions))
+    with tempfile.TemporaryDirectory(prefix="sensorarray-timing-probe-") as directory:
+        temp = Path(directory)
+        (temp / "driver_bus.h").write_text(driver_bus)
+        shutil.copytree(root / "tests/host/ads_stubs/freertos", temp / "freertos")
+        (temp / "freertos/FreeRTOS.h").write_text(
+            (root / "tests/host/ads_stubs/freertos/FreeRTOS.h").read_text()
+            .replace("configTICK_RATE_HZ 1000u", "configTICK_RATE_HZ 100u"))
+        (temp / "test.c").write_text(harness)
+        command = [cc, "-std=c11", "-Wall", "-Wextra", "-Werror",
+            "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
+            "-DCONFIG_SENSORARRAY_ADS_START_GPIO=48", "-DCONFIG_SENSORARRAY_ADS_DRDY_TIMEOUT_US=600"]
+        for path in (temp, root / "tests/host/ads_stubs", root / "tests/host/include",
+                     root / "components/ads126xAdc/include", root / "core/measure/ads",
+                     root / "core/measure/include", root / "core/config", root):
+            command += ["-I", str(path)]
+        binary = temp / "test"
+        subprocess.run(command + [str(temp / "test.c"), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
