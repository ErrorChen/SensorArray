         }
         case SENSORARRAY_COMMAND_ROW_MODES: {
             sensorarrayFdcSweepDiscardPendingForConfigChange();
             sensorarrayMeasurementMode_t modes[SENSORARRAY_ROW_MODE_PROFILE_ROWS];
