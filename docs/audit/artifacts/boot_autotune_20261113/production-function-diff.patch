+            (unsigned long)ESP_ERR_INVALID_STATE);
+    } else {
+        printf("CERR,cmd=%s,id=%lu,reason=wait_frontends,restartRequired=1\n",
+            sensorarrayCommandMailboxTypeName(command->type),
