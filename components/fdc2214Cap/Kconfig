menu "FDC2214Cap"

config FDC2214CAP_ENABLE
    bool "Enable FDC2214Cap component"
    default y

config FDC2214CAP_LOG_LEVEL
    int "Log level (0=none, 4=verbose)"
    range 0 4
    default 3
    depends on FDC2214CAP_ENABLE

config FDC2214CAP_MUTEX_TIMEOUT_MS
    int "Mutex lock timeout (ms)"
    range 1 10000
    default 200
    depends on FDC2214CAP_ENABLE
    help
        Finite timeout for internal driver mutex lock. Prevents indefinite waits.

config FDC2214CAP_LOW_LEVEL_I2C_TRACE
    bool "Trace every low-level FDC I2C transaction"
    default n
    depends on FDC2214CAP_ENABLE
    help
        Verbose printf trace for every FDC2214 I2C transaction. Keep disabled
        for normal matrix reads because it can saturate the serial monitor.

config FDC2214CAP_RAW_I2C_TRACE
    bool "Trace raw FDC2214 register reads/writes"
    default n
    depends on FDC2214CAP_ENABLE
    help
        Optional raw register trace for driver diagnostics only.

config FDC2214CAP_I2C_ADDR
    hex "I2C address (0x2A or 0x2B)"
    default 0x2A

config FDC2214CAP_CHANNELS
    int "Number of channels used (1..4)"
    default 4
    range 1 4


endmenu
