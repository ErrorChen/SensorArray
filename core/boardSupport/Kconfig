menu "Board Support (Pins/Buses)"

menu "I2C0 (SDA0/SCL0)"
config BOARD_I2C_PORT
    int "I2C port"
    range 0 1
    default 0

config BOARD_I2C_SDA_GPIO
    int "I2C SDA GPIO"
    default 9

config BOARD_I2C_SCL_GPIO
    int "I2C SCL GPIO"
    default 10

config BOARD_I2C_FREQ_HZ
    int "Legacy shared I2C frequency fallback (Hz)"
    default 337500
    help
        Compatibility fallback used when per-bus frequencies are not configured.

config BOARD_I2C_AUTO_FALLBACK_ENABLE
    bool "Enable I2C clock probe and fallback"
    default y

config BOARD_I2C_FALLBACK_LEVELS
    string "Documented I2C fallback levels"
    default "350000,337500,325000,300000"
    help
        The firmware probes these fixed levels in order during FDC bring-up.

config BOARD_I2C_PRIMARY_CLK_HZ_DEFAULT
    int "Primary I2C probe starting frequency (Hz)"
    default 350000
    range 100000 1000000

config BOARD_I2C_SECONDARY_CLK_HZ_DEFAULT
    int "Secondary I2C probe starting frequency (Hz)"
    default 350000
    range 100000 1000000

config BOARD_I2C_RUNTIME_FALLBACK_ERROR_FRAMES
    int "Consecutive runtime I2C error frames before fallback is allowed"
    default 3
    range 1 32

config BOARD_I2C_FREQ_HZ_TEST_337500
    bool "Document/test 337500 Hz I2C setting"
    default y

config BOARD_I2C_FREQ_HZ_TEST_350000
    bool "Document/test 350000 Hz I2C setting"
    default n

config BOARD_I2C_FREQ_HZ_TEST_375000
    bool "Document/test 375000 Hz I2C setting"
    default n

config BOARD_I2C_FREQ_HZ_TEST_400000
    bool "Document/test 400000 Hz I2C setting"
    default n

config BOARD_I2C0_FREQ_HZ
    int "I2C0 requested frequency (Hz)"
    default BOARD_I2C_FREQ_HZ

config BOARD_I2C1_FREQ_HZ
    int "I2C1 requested frequency (Hz)"
    default BOARD_I2C_FREQ_HZ

endmenu

menu "I2C2 (SDA2/SCL2, optional)"
config BOARD_I2C1_ENABLE
    bool "Enable secondary I2C bus"
    default y

config BOARD_I2C1_PORT
    int "I2C1 port (optional second bus)"
    range 0 1
    default 1

config BOARD_I2C1_SDA_GPIO
    int "I2C1 SDA GPIO (optional second bus)"
    default 11

config BOARD_I2C1_SCL_GPIO
    int "I2C1 SCL GPIO (optional second bus)"
    default 12
endmenu

menu "I2C recovery"

config SENSORARRAY_I2C_RECOVERY_ENABLED
    bool "Enable guarded I2C bus recovery"
    default y
    help
        Recovery is only attempted after an I2C timeout when SDA or SCL is
        confirmed low. Device NACKs do not delete or reinstall the driver.

config SENSORARRAY_I2C_RECOVERY_COOLDOWN_MS
    int "I2C recovery cooldown (ms)"
    default 1000
    range 0 600000

config SENSORARRAY_I2C_RECOVERY_MAX_FAILS
    int "I2C recovery failures before marking bus offline"
    default 3
    range 1 32

config SENSORARRAY_I2C_RECOVERY_TOGGLE_CLOCKS
    int "SCL pulses during I2C recovery"
    default 9
    range 1 32

endmenu

menu "SPI (ADS126x)"
config BOARD_SPI_HOST
    int "SPI host device (platform-specific)"
    default 2

config BOARD_SPI_SCLK_GPIO
    int "SPI SCLK GPIO"
    default 47

config BOARD_SPI_MOSI_GPIO
    int "SPI MOSI GPIO (ADS126x DIN)"
    default 21

config BOARD_SPI_MISO_GPIO
    int "SPI MISO GPIO (ADS126x DOUT)"
    default 14

config BOARD_ADS126X_CS_GPIO
    int "ADS126x CS GPIO (-1 if tied low)"
    default -1

config BOARD_ADS126X_DRDY_GPIO
    int "ADS126x DRDY GPIO (-1 if unused)"
    default 13

config BOARD_ADS126X_START_GPIO
    int "ADS126x START GPIO (-1 if unused)"
    default 48

config BOARD_ADS126X_RESET_GPIO
    int "ADS126x PWDN/RESET GPIO (-1 if unused)"
    default 38
endmenu

endmenu
