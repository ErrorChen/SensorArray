CONFIG_BOARD_I2C_FREQ_HZ=325000
CONFIG_SENSORARRAY_DEBUG_S5D5_SWEEP_SAMPLE_GAP_MS=4
# CONFIG_SENSORARRAY_DEBUG_S5D5_VERBOSE_SAMPLES is not set
# CONFIG_SENSORARRAY_DEBUG_S5D5_VISIBLE_DRIVE_ENABLE is not set
CONFIG_SENSORARRAY_DEBUG_S5D5_LOCKED_LOOP_TIMEOUT_MS=0
CONFIG_SENSORARRAY_DEBUG_S5D5_MAX_RESWEEP_COUNT=0
CONFIG_SENSORARRAY_DEBUG_CAP_FDC_RELOCK_FREQ_JUMP_REL_PERMILLE=100
# CONFIG_TMUX1108_SW_REF_LEVEL is not set
CONFIG_EXAMPLE_GATTS_NOTIFY_THROUGHPUT=y
CONFIG_EXAMPLE_GATTC_WRITE_THROUGHPUT=n
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
