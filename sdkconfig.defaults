# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_BOARD_I2C_FREQ_HZ=325000
CONFIG_SENSORARRAY_FDC_MATRIX_PERIOD_MS=250
CONFIG_SENSORARRAY_FDC_MATRIX_SETTLE_US=1000
CONFIG_SENSORARRAY_FDC_MATRIX_DISCARD_SAMPLES=1
CONFIG_SENSORARRAY_FDC_DISCARD_FRAMES_AFTER_ROW_SWITCH=1
CONFIG_SENSORARRAY_FDC_FAST_SWEEP_COOLDOWN_MS=30000
CONFIG_SENSORARRAY_FDC_FAST_SWEEP_MIN_COOLDOWN_MS=30000
# CONFIG_SENSORARRAY_FDC_RUNTIME_FAST_SWEEP_ENABLE is not set
CONFIG_SENSORARRAY_FDC_REAPPLY_CACHE_ON_WARNING=y
CONFIG_SENSORARRAY_FDC_WARNING_REAPPLY_THRESHOLD=2
CONFIG_SENSORARRAY_FDC_RESCUE_HARD_ERROR_THRESHOLD=4
CONFIG_SENSORARRAY_FDC_FULL_RESCUE_COOLDOWN_MS=3000
CONFIG_SENSORARRAY_FDC_ALL_INVALID_RESCUE_THRESHOLD=3
CONFIG_SENSORARRAY_FDC_CELL_FAST_SWEEP_FAIL_THRESHOLD=2
CONFIG_SENSORARRAY_FDC_ROW_RESCUE_FAIL_COUNT=4
CONFIG_SENSORARRAY_FDC_RESCUE_TASK_STACK=12288
# CONFIG_SENSORARRAY_FDC_VERBOSE_SCAN_LOG is not set
# CONFIG_SENSORARRAY_FDC_RAW_DEBUG_LOG is not set
CONFIG_SENSORARRAY_FDC_TIMING_LOG_EVERY_N_FRAMES=10
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# CONFIG_TMUX1108_SW_REF_LEVEL is not set
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
